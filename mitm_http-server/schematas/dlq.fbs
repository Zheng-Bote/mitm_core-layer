namespace schematas;

table DLQEntry {
  id: string;
  package_id: string;
  payload: string;
  error_code: string;
  error_message: string;
  failed_at: string;
  failed_at_unix_ms: int64;
  resolved: bool;
  resolved_at: string;
  resolved_at_unix_ms: int64;
}

table DLQEntryList {
  entries: [DLQEntry];
}

root_type DLQEntryList;
